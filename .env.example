DOCALIGN_MAX_FILES=300
DOCALIGN_MAX_TOTAL_MB=500
DOCALIGN_MAX_FILE_MB=25
DOCALIGN_MAX_PIXELS=60000000
DOCALIGN_MAX_JOB_SECONDS=1800
DOCALIGN_MAX_CONCURRENT_JOBS=1
DOCALIGN_MAX_LIVE_JOBS=10
DOCALIGN_WORKERS=2
DOCALIGN_RETENTION_MINUTES=30
# projection_profile | min_area_rect | consensus  (default is PROVISIONAL)
DOCALIGN_SKEW_METHOD=projection_profile
